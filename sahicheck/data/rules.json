{
  "free_mail_domains": [
    "gmail.com",
    "googlemail.com",
    "yahoo.com",
    "yahoo.co.in",
    "ymail.com",
    "outlook.com",
    "hotmail.com",
    "live.com",
    "rediffmail.com",
    "proton.me",
    "protonmail.com",
    "aol.com"
  ],
  "suspicious_tlds": [
    "xyz",
    "top",
    "click",
    "icu",
    "cfd",
    "sbs",
    "buzz",
    "work",
    "site",
    "online",
    "shop",
    "live",
    "rest",
    "monster"
  ],
  "shorteners": [
    "bit.ly",
    "tinyurl.com",
    "cutt.ly",
    "rb.gy",
    "is.gd",
    "t.ly",
    "shorturl.at"
  ],
  "lookalike_threshold": 85,
  "hard_cap_ids": [
    "fee_demand",
    "otp_request",
    "id_document_request"
  ],
  "cap_35_ids": [
    "lookalike_domain",
    "blocklisted_domain"
  ],
  "keyword_rules": [
    {
      "id": "fee_demand",
      "severity": "high",
      "why": "Legitimate employers never demand registration, training, security deposit, or kit fees from candidates.",
      "patterns": [
        "(?i)\\b(?:registration|training|kit|security\\s*deposit|processing|refundable|joining|onboarding)\\s*(?:fee|fees|charges?|amount|cost)\\b",
        "(?i)\\b(?:pay|deposit|send|transfer)\\s+(?:Rs\\.?|INR|₹)?\\s*\\d+[\\d,]*(?:\\s*\\/-)?\\s*(?:as|for|towards)?\\s*(?:fee|fees|charges?|registration|deposit|training)?\\b",
        "(?i)\\b(?:registration\\s*fees?\\s*jama\\s*karo|paise\\s*bhejo|pehle\\s*payment|advance\\s*fee|security\\s*jama)\\b",
        "(?:रजिस्ट्रेशन\\s*शुल्क|सिक्योरिटी\\s*डिपॉजिट|पैसे\\s*जमा|फीस\\s*जमा)",
        "(?i)\\bfee\\s*of\\s*(?:Rs\\.?|INR|₹)?\\s*\\d+"
      ]
    },
    {
      "id": "upi_or_bank_request",
      "severity": "high",
      "why": "Demands to send money via personal UPI handles, payment apps, or bank accounts are a hallmark of job scams.",
      "patterns": [
        "(?i)\\b(?:pay|send|transfer|deposit|bhejo)\\b.{0,30}\\b(?:via|through|to|on)?\\s*(?:upi|gpay|google\\s*pay|phonepe|paytm|bank\\s*account)\\b",
        "(?i)\\b(?:upi\\s*id|vpa|google\\s*pay|phonepe|paytm\\s*number)\\b.{0,35}\\b(?:pay|send|transfer|bhejo|jama)\\b",
        "(?i)\\b(?:pay|send|transfer|deposit)\\s+to\\s+[a-zA-Z0-9.\\-_]+@[a-zA-Z0-9]+\\b",
        "(?:यूपीआई|फोनपे|गूगल\\s*पे|पेटीएम|खाता\\s*संख्या).{0,25}(?:पे|भेजें|जमा|ट्रांसफर)"
      ]
    },
    {
      "id": "otp_request",
      "severity": "high",
      "why": "Genuine recruiters will never ask you to share an OTP or one-time verification code.",
      "patterns": [
        "(?i)\\b(?:otp|one\\s*time\\s*password|verification\\s*code)\\b.{0,35}\\b(?:share|send|tell|give|provide|batao|bata\\s*do|bhejo)\\b",
        "(?i)\\b(?:share|send|tell|give|provide|enter|batao|bata\\s*do|bhejo)\\b.{0,35}\\b(?:otp|one\\s*time\\s*password|verification\\s*code)\\b",
        "(?i)\\botp\\s*bata\\s*do\\b",
        "(?:ओटीपी|वेरिफिकेशन\\s*कोड).{0,25}(?:बताएं|शेयर|भेजें|दीजिए)"
      ]
    },
    {
      "id": "id_document_request",
      "severity": "high",
      "why": "Asking for photos or scans of Aadhaar, PAN, or bank cards over chat/email before official joining risks identity theft.",
      "patterns": [
        "(?i)\\b(?:send|share|upload|whatsapp|email|forward|bhejo)\\b.{0,50}\\b(?:aadhaar|pan\\s*(?:card)?|passport|bank\\s*(?:details|passbook)|cheque|voter\\s*id)\\b.{0,30}\\b(?:photo|copy|image|scan|details)?\\b",
        "(?i)\\b(?:photo|copy|image|scan)\\s+of\\s+(?:your\\s+)?(?:aadhaar|pan\\s*(?:card)?|passport|bank\\s*passbook)\\b.{0,40}\\b(?:send|share|upload|whatsapp|email|bhejo)\\b",
        "(?i)\\b(?:aadhaar|pan\\s*(?:card)?|passport)\\b.{0,30}\\b(?:photo|copy|image|scan)\\b.{0,40}\\b(?:send|share|upload|whatsapp|email|bhejo)\\b",
        "(?:आधार|पैन\\s*कार्ड|पासपोर्ट).{0,30}(?:फोटो|कॉपी|स्कैन).{0,30}(?:भेजें|शेयर|अपलोड)"
      ]
    },
    {
      "id": "urgency",
      "severity": "low",
      "why": "Artificial urgency is used by fraudsters to rush candidates into acting without verifying details.",
      "patterns": [
        "(?i)\\b(?:immediately|today\\s*only|last\\s*chance|limited\\s*vacanc(?:y|ies)|urgent\\s*requirement|offer\\s*expires\\s*today|act\\s*now|aaj\\s*hi|turant)\\b",
        "(?:आज\\s*ही|तुरंत|अंतिम\\s*अवसर|सीमित\\s*सीटें)"
      ]
    },
    {
      "id": "guaranteed_job_or_pay",
      "severity": "medium",
      "why": "Promises of 100% placement or high earnings without required skills are standard job scam bait.",
      "patterns": [
        "(?i)\\b(?:guaranteed\\s*job|100%\\s*placement|guaranteed\\s*placement|unrealistic\\s*earnings?)\\b",
        "(?i)\\bearn\\s*(?:per|daily|weekly|every)\\s*(?:day|month|week)\\s*(?:without|no)\\s*skills?\\b",
        "(?i)\\b(?:earn|kamaye|kamao)\\s+(?:Rs\\.?|INR|₹)?\\s*\\d+\\s*(?:per\\s*day|daily|per\\s*month)\\s*(?:simple|typing|data\\s*entry|no\\s*interview)?\\b",
        "(?:100%\\s*गारंटीड|घर\\s*बैठे\\s*कमाएं|बिना\\s*किसी\\s*स्किल)"
      ]
    },
    {
      "id": "no_interview",
      "severity": "medium",
      "why": "Reputable companies evaluate candidates before offering jobs; skipping interviews indicates fraudulent operations.",
      "patterns": [
        "(?i)\\b(?:no\\s*interview|direct\\s*joining|direct\\s*selection|selected\\s*without\\s*(?:an?\\s*)?interview|bina\\s*interview)\\b",
        "(?:बिना\\s*इंटरव्यू|सीधी\\s*भर्ती|डायरेक्ट\\s*जॉइनिंग)"
      ]
    },
    {
      "id": "offplatform_channel_only",
      "severity": "medium",
      "why": "Conducting interviews or training solely through personal chat apps like Telegram or WhatsApp avoids scrutiny.",
      "patterns": [
        "(?i)\\b(?:contact|join|training|apply|interview)\\s*(?:only|strictly)?\\s*(?:via|on|through)\\s*(?:telegram|whatsapp|t\\.me|wa\\.me)\\b",
        "(?i)\\b(?:telegram|whatsapp)\\s*(?:only|par\\s*contact\\s*kare|pe\\s*message\\s*kare)\\b",
        "(?:केवल\\s*व्हाट्सएप|टेलीग्राम\\s*पर\\s*संपर्क)"
      ]
    }
  ]
}
